#Define our state as a typed dictionary and tell Lang graph how to handle message
from typing import TypedDict, Annotated
#Define message types base type for all messages / human messages / system message -> personality
from langchain_core.messages import BaseMessage, HumanMessage,SystemMessage
# LLM model
from langchain_openai import ChatOpenAI
# Build and finish our graph
from langgraph.graph import StateGraph, END
# load api from env
from dotenv import load_dotenv
# to accumlate messages
import operator
import os


load_dotenv()

# ─────────────────────────────────────────
# 1. Define LLM
# ─────────────────────────────────────────
llm = ChatOpenAI(model="gpt-4o-mini", temperature=0)


# ─────────────────────────────────────────
# 2. State Definition
# ─────────────────────────────────────────
class SupportState(TypedDict):
    messages: Annotated[list[BaseMessage], operator.add]
    should_escalate: bool
    issue_type: str
    user_tier: str  # "vip" or "standard"


# ─────────────────────────────────────────
# 3. Nodes
# ─────────────────────────────────────────

def check_user_tier_node(state: SupportState):
    """Looks at the message and decides if user is VIP or standard and sets user_tier accordingly"""
    first_message = state["messages"][0].content.lower()
    if "vip" in first_message or "premium" in first_message:
        return {"user_tier": "vip"}
    return {"user_tier": "standard"}


def vip_agent_node(state: SupportState):
    """Handles VIP customers — fast lane, no escalation and sets should_escalate to false"""
    # You can call an LLM here if you want.
	# For the assignment it is fine to just set a friendly VIP response.
    
    # Add a system message for VIP handling
    system = SystemMessage(content="You are a premium VIP support agent. Be extra helpful and concise.")
  
    messages = state["message"]
  
    # construct and add the single system message to the list of messages 
    response = llm.invoke([system] + messages)

    return {
        "should_escalate": False,
    }


def standard_agent_node(state: SupportState):
    """Handles standard customers — may escalate"""
    # For now, just mark should_escalate = True to simulate escalation.
    return {
        "should_escalate": True,
    }


# ─────────────────────────────────────────
# 4. Routing Function
# ─────────────────────────────────────────
def route_by_tier(state: SupportState) -> str:
    """Decides which path to take based on user tier"""
    if state.get("user_tier") == "vip":
        return "vip_path"
    return "standard_path"


# ─────────────────────────────────────────
# 5. Build Graph
# ─────────────────────────────────────────
def build_graph():
    workflow = StateGraph(SupportState)

    # Add nodes
    workflow.add_node("check_tier", check_user_tier_node)
    workflow.add_node("vip_agent", vip_agent_node)
    workflow.add_node("standard_agent", standard_agent_node)

    # Set starting point
    workflow.set_entry_point("check_tier")

    # Add routing logic
    workflow.add_conditional_edges(
        "check_tier",
        route_by_tier,
        {
            "vip_path": "vip_agent",
            "standard_path": "standard_agent",
        },
    )

    # Add end points
    workflow.add_edge("vip_agent", END)
    workflow.add_edge("standard_agent", END)

    return workflow.compile()


# ─────────────────────────────────────────
# 5. Main
# ─────────────────────────────────────────
def main() -> None:
    graph = build_graph()

    # VIP run

    vip_message = {
        "messages": [HumanMessage(content="I'm a VIP customer, please check my order")],
        "should_escalate": False,
        "issue_type": "",
        "user_tier": ""
    }

    vip_result = graph.invoke({
        "messages": [HumanMessage(content="I'm a VIP customer, please check my order")],
        "should_escalate": False,
        "issue_type": "",
        "user_tier": "",
    })
    print("─── VIP Result ───")
    print(f"  user_tier:       {vip_result.get('user_tier')}")
    print(f"  should_escalate: {vip_result.get('should_escalate')}")

    # Standard run

    stanard_message ={
        "messages": [HumanMessage(content="Check my order status")],
        "should_escalate": False,
        "issue_type": "",
        "user_tier": ""    
    }

    standard_result = graph.invoke({
        "messages": [HumanMessage(content="Check my order status")],
        "should_escalate": False,
        "issue_type": "",
        "user_tier": "",
    })
    print("─── Standard Result ───")
    print(f"  user_tier:       {standard_result.get('user_tier')}")
    print(f"  should_escalate: {standard_result.get('should_escalate')}")


if __name__ == "__main__":
    main()